import QtQuick
import QtQuick.Shapes
import qs.Commons

// The Nearby logo, drawn as a vector so it stays sharp at bar and hero sizes
// and takes the theme colour like the glyphs around it. The path is the one in
// assets/nearby-icon.svg, on its 844 x 844 canvas.
Item {
  id: root

  property real iconSize: Style.font.icon
  property color color: Color.foreground

  width: iconSize
  height: iconSize
  implicitWidth: iconSize
  implicitHeight: iconSize

  Shape {
    width: 844
    height: 844
    preferredRendererType: Shape.CurveRenderer
    transform: Scale { xScale: root.iconSize / 844; yScale: root.iconSize / 844 }

    ShapePath {
      fillColor: root.color
      strokeWidth: -1
      PathSvg { path: "M506 791C471 787 461 746 491 732C497 730 498 730 524 728C641 720 736 636 758 520C764 492 775 481 794 482C819 484 829 506 821 544C799 655 703 753 590 782C559 790 526 793 506 791ZM122 726C44 715 -12 636 3 558C13 503 61 456 120 443C134 440 167 441 181 444C215 453 244 473 263 501C272 514 273 514 292 509C314 503 337 489 355 472C372 456 382 441 405 399C442 329 484 294 556 274C564 273 566 270 569 262C584 222 621 185 662 172C737 147 812 186 837 262C856 320 835 382 784 419C716 468 628 452 582 382C574 368 573 368 557 373C532 379 507 395 489 416C476 430 467 445 449 482C427 527 415 544 395 562C368 586 340 600 302 610C286 614 286 614 282 627C263 680 219 716 164 726C154 727 131 727 122 726ZM499 670C474 661 472 629 496 617C501 615 505 614 514 613C571 608 618 573 639 519C649 495 674 487 690 503C702 516 701 531 687 560C656 621 594 664 527 671C513 672 505 672 499 670ZM31 388C24 386 16 377 13 369C8 353 12 329 25 294C73 158 204 57 337 53C360 53 365 53 375 58C399 70 398 104 373 115C368 118 365 118 351 119C302 122 264 132 224 154C151 193 96 265 77 348C73 370 71 373 65 380C55 389 43 392 31 388ZM157 376C151 373 145 366 143 359C139 348 142 336 154 311C191 236 258 189 340 182C368 179 383 190 383 210C383 227 372 238 353 240C306 245 274 259 245 288C225 307 213 325 203 350C195 370 186 378 170 378C164 378 161 377 157 376Z" }
