#!/usr/bin/env bash

# Prefetch the immutable helper selected by this checkout. Progress is NDJSON
# so Service.qml can present it without parsing human-readable diagnostics.

set -uo pipefail

plugin_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)" || exit 1
readonly plugin_dir
readonly launcher="$plugin_dir/bin/nearby-helper-launcher"

emit() { jq -nc "$@" 2>/dev/null || printf '{"event":"failed","message":"could not report progress"}\n'; }
fail() {
  emit --arg m "$1" '{event:"failed",message:$m}'
  exit 1
}

command -v jq >/dev/null 2>&1 \
  || { printf '{"event":"failed","message":"required command not found: jq"}\n'; exit 1; }
[[ -x $launcher && ! -L $launcher ]] || fail "The Nearby helper launcher is missing or unsafe."

emit --arg m "Preparing the verified Nearby helper…" '{event:"step",message:$m}'
output=$("$launcher" --prefetch 2>&1) || fail "$output"
[[ $output =~ ^omarchy-nearby-helper[[:space:]]+([0-9]+\.[0-9]+\.[0-9]+)$ ]] \
  || fail "The helper launcher returned an unexpected version."
emit --arg v "${BASH_REMATCH[1]}" '{event:"done",version:$v}'
