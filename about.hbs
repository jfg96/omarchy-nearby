<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>Omarchy Nearby third-party licenses</title>
  <style>body{font-family:sans-serif;max-width:72rem;margin:2rem auto;padding:0 1rem}pre{white-space:pre-wrap}</style>
</head>
<body>
  <h1>Omarchy Nearby third-party licenses</h1>
  <p>Generated from the dependency graph locked for this release.</p>
  {{#each licenses}}
    <h2>{{name}}</h2>
    <p>Used by:</p>
    <ul>
      {{#each used_by}}
        <li>{{crate.name}} {{crate.version}}</li>
      {{/each}}
    </ul>
    <pre>{{text}}</pre>
  {{/each}}
</body>
</html>
